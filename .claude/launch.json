{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web-demo",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8765",
        "--directory",
        "web"
      ],
      "port": 8765
    },
    {
      "name": "nextjs-example",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web/examples/nextjs",
        "run",
        "start"
      ],
      "port": 3100
    },
    {
      "name": "blog",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8766"
      ],
      "port": 8766
    }
  ]
}